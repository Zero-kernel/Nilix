# Rust
/target/
/target-*

# R180 synchronization/debug artifacts (generated, never source)
/.r180-*
userspace/target/
userspace-target/
userspace/fuzzer/target/
Cargo.lock


# Binaries
/.vscode
/.claude
/.codex
# scripts/: ignore local-only tooling, but keep CI/gate harnesses trackable.
# (A bare `/scripts` directory ignore cannot be re-opened by later `!` rules.)
/scripts/*
!/scripts/boot_check.sh
!/scripts/musl_check.sh
!/scripts/kernel_test.sh
!/scripts/smp_test.sh
!/scripts/smp_test_4core.sh
!/scripts/afl_fuzz.sh
!/scripts/afl_parallel.sh
!/scripts/afl_triage.sh
!/scripts/generate_afl_seeds.py
!/scripts/generate_fuzz_report.py
!/scripts/generate_fuzz_summary.py
!/scripts/parse_fuzz_output.py
# D2-TST/D2-ERR gate harnesses (design-queue round 2026-07-24). NOTE: after this
# whitelist lands, the files still need a one-time manual `git add -f` + commit
# (Git Rule: commits are user-initiated) before the CI lint job can see them.
!/scripts/abi_layout_oracle.py
!/scripts/lint_fallible.sh
# Directory trap: /scripts/* ignores the directory ENTRY, so per-file negation
# cannot descend — both the dir and its contents must be negated.
!/scripts/lint_fallible_fixtures/
!/scripts/lint_fallible_fixtures/*
/esp
/bootloader-target
/kernel-target
/clippy-target
/clippy-kernel-target
/clippy-bootloader-target
/clippy-boot-target
/clippy-userspace-target
userspace/clippy-userspace-target

# Fuzz testing
/fuzz/target/
/fuzz/corpus/
/fuzz/artifacts/*.log

#no_need
*.backup
*.md
*.txt
*.log
*.skill
.tmp-*/
core

!README.md
!README_zh.md
!CONTRIBUTING.md
!roadmap.md
!roadmap-enterprise.md
